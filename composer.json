{
  "name": "relaypdf/relaypdf",
  "description": "Official PHP SDK for RelayPDF — HTML, Markdown, URL, and templates to PDF, LibreOffice convert, PDF tools, barcodes, zip, async jobs, and webhook verification",
  "type": "library",
  "license": "MIT",
  "keywords": ["pdf", "html-to-pdf", "url-to-pdf", "markdown-to-pdf", "relaypdf", "documents", "libreoffice"],
  "homepage": "https://relaypdf.com/docs/sdks/php",
  "authors": [
    {
      "name": "RelayPDF",
      "email": "support@relaypdf.com",
      "homepage": "https://relaypdf.com"
    }
  ],
  "support": {
    "email": "support@relaypdf.com",
    "docs": "https://relaypdf.com/docs/sdks/php",
    "issues": "https://github.com/timspell1/relaypdf-php/issues",
    "source": "https://github.com/timspell1/relaypdf-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["src/"],
    "psr-4": {
      "RelayPDF\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RelayPDF\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
